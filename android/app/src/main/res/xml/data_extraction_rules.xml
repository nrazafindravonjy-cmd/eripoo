<?xml version="1.0" encoding="utf-8"?>
<!--
  Eripoo: private project data must never leave the device through Android
  cloud backup or device-to-device transfer (see docs/SECURITY.md).
  allowBackup="false" covers Android < 12; these rules cover Android 12+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
